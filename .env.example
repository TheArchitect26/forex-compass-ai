# Market data providers
# Required for live market candles. If empty, backend returns synthetic demo data + warning.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
TRADING_ECONOMICS_KEY=
NEWS_API_KEY=

# Database (required)
# Docker default value (recommended):
# DATABASE_URL=postgresql+asyncpg://forex:forex@postgres:5432/forex
POSTGRES_USER=forex
POSTGRES_PASSWORD=forex
POSTGRES_DB=forex
DATABASE_URL=postgresql+asyncpg://forex:forex@postgres:5432/forex

# Redis / Celery (required)
# Docker default value (recommended):
# REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auth (required outside local/dev/test)
# For production/staging, set a long random secret (32+ chars). Never use defaults.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

APP_ENV=local

# Seven-day signal validation training only. Does not execute trades.
AUTO_TRAINING_ENABLED=false
AUTO_TRAINING_INTERVAL_MINUTES=30
AUTO_TRAINING_SYMBOLS=["EUR/USD","GBP/USD","USD/JPY","AUD/USD","USD/CAD","USD/CHF","NZD/USD","XAU/USD"]
